# ============================================================
# 测试环境 compose 变量（拷贝为 .env 后按需修改）
# ------------------------------------------------------------
# 用法：
#   cd deploy
#   cp .env.example .env
#   # 编辑 .env
#   docker compose up -d --build
# ============================================================

# MySQL 根密码
MYSQL_ROOT_PASSWORD=ChangeMeRoot2026

# 应用数据库与账号
MYSQL_DATABASE=stunning_fast
MYSQL_USER=juese
MYSQL_PASSWORD=ChangeMeApp2026

# JWT 密钥（测试环境用默认；正式上线务必换）
