# ============================================================
# 天翼云 ZOS 对象存储凭证（拷贝为 .oss.env 后填入实际值）
# ------------------------------------------------------------
# 用法：
#   cd deploy
#   cp .oss.env.example .oss.env
#   # 编辑 .oss.env 填入 AccessKey / Secret
#   cd ..
#   powershell -File scripts\release-to-oss.ps1
#
# .gitignore 已排除 .oss.env，不会泄露到仓库
# ============================================================

# 天翼云 ZOS AccessKey（云控制台 → 访问控制 → 用户 → 创建 AccessKey）
OSS_ACCESS_KEY_ID=your_access_key_id_here

# 对应 Secret（创建时仅展示一次，请妥善保存）
OSS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Bucket 名（截图中：bucket-5620）
OSS_BUCKET=bucket-5620

# 终端节点：本地 / 跨地域上传用外网 HTTPS
# 服务器与本 Bucket 同资源池时，可改用内网省流量：
#   http://zhengzhou-5-internal.zos.ctyun.cn
OSS_ENDPOINT=https://zhengzhou5.zos.ctyun.cn

# 区域标识（天翼云 ZOS 用 region=cn-zhengzhou-5 或 auto）
OSS_REGION=auto

# 公网访问基址（electron-updater 拉取 latest.yml 与安装包的根 URL）
# 截图中 Bucket 外网访问为：https://bucket-5620.zhengzhou5.zos.ctyun.cn
# 注意：需在 Bucket 控制台开启「公共读」或对 release/ 前缀开放匿名读
OSS_PUBLIC_BASE=https://bucket-5620.zhengzhou5.zos.ctyun.cn

# 上传前缀（用户在 OSS 控制台已建好的 release/ 目录）
OSS_RELEASE_PREFIX=release

# 可选：服务器同资源池内网上传开关（true 时 OSS_ENDPOINT 应改用内网 endpoint）
# 仅当从部署服务器（1.194.28.136）上跑此脚本时设为 true
OSS_USE_INTERNAL=false
