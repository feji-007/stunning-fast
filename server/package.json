{
    "version":  "1.0.0",
    "name":  "stunning-fast-server",
    "description":  "绝色后台管理系统 - 系统配置与用户配置管理服务",
    "scripts":  {
                    "start":  "node dist/index.js",
                    "admin:build":  "cd admin \u0026\u0026 npm run build",
                    "build":  "tsc -p tsconfig.json",
                    "migrate:pending":  "tsx src/db/migrate.ts pending",
                    "admin:install":  "cd admin \u0026\u0026 npm install",
                    "migrate":  "tsx src/db/migrate.ts",
                    "migrate:status":  "tsx src/db/migrate.ts status",
                    "admin:dev":  "cd admin \u0026\u0026 npm run dev",
                    "dev":  "tsx watch src/index.ts"
                },
    "dependencies":  {
                         "mysql2":  "^3.11.0",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.5",
                         "bcryptjs":  "^2.4.3",
                         "jsonwebtoken":  "^9.0.2",
                         "express":  "^4.19.2"
                     },
    "devDependencies":  {
                            "@types/cors":  "^2.8.17",
                            "@types/express":  "^4.17.21",
                            "typescript":  "^5.4.5",
                            "@types/jsonwebtoken":  "^9.0.6",
                            "@types/bcryptjs":  "^2.4.6",
                            "@types/node":  "^20.14.10",
                            "tsx":  "^4.16.0"
                        },
    "main":  "dist/index.js"
}
