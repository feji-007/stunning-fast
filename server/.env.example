# 服务端口
PORT=4178

# 数据库连接（MySQL 8.x）：mysql://用户名:密码@主机:端口/库名
DATABASE_URL=mysql://root:123456@localhost:3306/stunning_fast

# JWT 密钥（生产环境请改为随机长串）
JWT_SECRET=stunning-fast-dev-secret-change-me
JWT_EXPIRES_IN=7d

# 管理员初始账号（首次启动时自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 跨域允许的来源（客户端桌面应用来源）
CORS_ORIGIN=*

# 客户端桌面应用将连接此地址
CLIENT_API_BASE=http://localhost:4178