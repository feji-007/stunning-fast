# ============================================================
# 生产环境配置模板
# ------------------------------------------------------------
# 用法：cp server/.env.production.example server/.env
#       然后填入实际值（切勿提交 server/.env）
# 建议：用 Nginx/Caddy 反代到 PORT=4178，对外统一 https://api.yourdomain.com
# ============================================================

# 服务监听端口（若用反代，保持 4178 即可，反代层负责 80/443）
PORT=4178
NODE_ENV=production

# MySQL 8.x 连接：mysql://用户名:密码@主机:端口/库名
# 主机建议用内网 IP 或 localhost，不要暴露公网；生产账号务必强密码
DATABASE_URL=mysql://<user>:<strong-password>@<host>:3306/stunning_fast

# JWT 密钥：生产必须改为 32 字节以上随机串
# 生成方式：openssl rand -hex 32  或  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<replace-with-random-32-byte-hex>
JWT_EXPIRES_IN=7d

# 管理员初始账号（首次启动自动创建，之后修改此值无效，需在管理后台改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong-password>

# 跨域允许来源：建议收敛为客户端实际来源，避免 *
# 多个用逗号分隔，如 https://yourdomain.com,app://juese
CORS_ORIGIN=*

# Electron 客户端将连接此地址：必须为服务器对外可访问的公网 URL
# 反代场景下用域名；无反代时用 http://<服务器公网IP>:4178
CLIENT_API_BASE=https://api.yourdomain.com
