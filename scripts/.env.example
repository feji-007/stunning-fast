# ============================================================
# Cloudflare R2 + CDN 配置（发布/上传时使用，后端运行不需要）
# 复制本文件为 scripts/.env 并填入实际值
# ------------------------------------------------------------

# Cloudflare 账号 ID：控制台 右侧栏 或 R2 概览页可查
R2_ACCOUNT_ID=

# API Token：R2 > Manage R2 API Tokens > Create API token
# 权限选「Object Read & Write」，作用于目标桶
# 创建后会显示 Access Key ID 与 Secret Access Key（仅显示一次，务必保存）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 桶名（需在 R2 控制台预先创建，如 juese-assets）
R2_BUCKET=juese-assets

# 公开访问基址（决定上传后返回的 CDN URL）：
#  - 开发期：https://pub-<hash>.r2.dev  （在桶 Settings 里开启 Public dev URL）
#  - 生产期：https://cdn.juese.app      （在桶 Settings > Custom Domains 绑定，走 Cloudflare CDN）
R2_PUBLIC_BASE=https://cdn.juese.app

# 可选：覆盖默认扫描目录与上传前缀
R2_RELEASE_DIR=release
R2_RELEASE_PREFIX=releases
R2_SITE_DIR=site/.vitepress/dist
R2_SITE_PREFIX=

# ============================================================
# Cloudflare CDN 缓存刷新（可选，上传后自动刷新 latest*.yml / index.html）
# 未配置则跳过刷新，不影响上传，仅更新生效延迟最长 5 分钟
# ------------------------------------------------------------
# API Token：My Profile > API Tokens > Create Token，权限 Zone > Cache Purge
# Zone ID：网站 Overview 页右下角「API 区域」可查
CF_API_TOKEN=
CF_ZONE_ID=